; Macs only (Please reads .plzconfig_<os>_<arch> on a host of that platform).
;
; A Mac's own C compiler only targets macOS, so for test/cgo's ///linux_amd64
; build every C tool is this plugin's toolchain: the Mac's own tool for an
; action building for macOS, zig for one building for Linux. Go also links
; every static binary with its CCTool, and go-rules' cgo_library compiles its C
; with cc-rules' tools, so both plugins are set.
;
; Go's DefaultStatic stays on, as .plzconfig sets it. macOS has no fully static
; binaries, so for a Mac's own binaries the toolchain drops -static and they
; link dynamically. Turning it off here would turn it off for ///linux_amd64
; too: an architecture subrepo takes go-rules' DefaultStatic from the host's
; config, and Go's internal linker cannot link a Linux cgo binary.
[Plugin "go"]
CCTool = //:toolchain|cc
ARTool = //:toolchain|ar

[Plugin "cc"]
CCTool = //:toolchain|cc
CPPTool = //:toolchain|c++
ARTool = //:toolchain|ar
LDTool = //:toolchain|ld
