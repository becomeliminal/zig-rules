; Macs only (Please reads .plzconfig_<os>_<arch> on a host of that platform).
;
; A Mac's own C compiler only targets macOS, so for test/cgo's ///linux_amd64
; build Go's C tools are this plugin's toolchain: the Mac's own tool for an
; action building for macOS, zig for one building for Linux. Go also links
; every static binary with its CCTool.
[Plugin "go"]
CCTool = //:toolchain|cc
ARTool = //:toolchain|ar
